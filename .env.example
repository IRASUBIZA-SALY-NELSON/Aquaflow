# Copy values into firmware/aquaflow_esp32/aquaflow_esp32.ino before flashing.

WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD
SERVER_HOST=192.168.x.x
SERVER_PORT=9090
DEVICE_ID=aquaflow-esp32-01

# Backend runtime
AQUAFLOW_SIMULATE=0
AQUAFLOW_SERIAL=/dev/ttyACM0
AQUAFLOW_BAUD=115200
AQUAFLOW_PORT=9090
AQUAFLOW_LEAK_SEC=8
AQUAFLOW_CONTINUOUS_SEC=45
